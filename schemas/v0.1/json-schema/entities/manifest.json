{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bds.pub/schemas/v0.1/entities/manifest.json",
  "title": "Manifest",
  "description": "An immutable snapshot of a book version. Created each time an author publishes changes.",
  "type": "object",
  "required": ["id", "book_id", "version", "published_at", "toc", "stats"],
  "properties": {
    "id": {
      "$ref": "../validators/did.json",
      "description": "Unique identifier for this manifest"
    },
    "book_id": {
      "$ref": "../validators/did.json",
      "description": "Reference to parent Book"
    },
    "version": {
      "$ref": "../validators/semver.json",
      "description": "Version number (major.minor.patch)"
    },
    "changelog": {
      "type": "string",
      "maxLength": 5000,
      "description": "Description of changes in this version"
    },
    "published_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Publication timestamp"
    },
    "toc": {
      "type": "array",
      "description": "Table of contents with chapter references",
      "items": {
        "type": "object",
        "required": ["chapter_id", "chapter_version", "order", "title"],
        "properties": {
          "chapter_id": {
            "$ref": "../validators/did.json",
            "description": "Chapter reference"
          },
          "chapter_version": {
            "$ref": "../validators/semver.json",
            "description": "Specific version of the chapter"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Reading order position"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Chapter title (for display)"
          },
          "section": {
            "type": "string",
            "maxLength": 200,
            "description": "Grouping label (e.g., 'Part 1', 'Prologue')"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "stats": {
      "type": "object",
      "required": ["total_chapters", "word_count", "estimated_reading_time_minutes"],
      "properties": {
        "total_chapters": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of chapters"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total word count"
        },
        "estimated_reading_time_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated reading time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

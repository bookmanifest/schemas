{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bds.pub/schemas/v0.1/entities/series.json",
  "title": "Series",
  "description": "A collection of related books in reading order (trilogies, sagas, etc.)",
  "type": "object",
  "required": ["id", "title", "author_ids", "status", "created_at", "updated_at"],
  "properties": {
    "id": {
      "$ref": "../validators/did.json",
      "description": "Unique identifier for the series"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Series title"
    },
    "description": {
      "type": "string",
      "maxLength": 5000,
      "description": "Series description"
    },
    "author_ids": {
      "type": "array",
      "description": "Authors (supports multiple for collaborations)",
      "items": {
        "$ref": "../validators/did.json"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "cover_image": {
      "$ref": "../validators/url.json",
      "description": "Series cover art URL"
    },
    "genres": {
      "type": "array",
      "description": "Genre tags",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "maxItems": 10
    },
    "status": {
      "type": "string",
      "enum": ["ongoing", "completed", "hiatus"],
      "description": "Series status"
    },
    "created_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Last update timestamp"
    }
  },
  "additionalProperties": false
}

{
  "name": "@bookmanifest/schemas",
  "version": "0.3.1",
  "description": "Formal schemas for Book Manifest (v0.1, and v0.3 with the narrative layer and reading events)",
  "type": "module",
  "main": "./dist/v0.1/index.js",
  "types": "./dist/v0.1/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v0.1/index.d.ts",
      "default": "./dist/v0.1/index.js"
    },
    "./v0.1": {
      "types": "./dist/v0.1/index.d.ts",
      "default": "./dist/v0.1/index.js"
    },
    "./entities": {
      "types": "./dist/v0.1/zod/entities.d.ts",
      "default": "./dist/v0.1/zod/entities.js"
    },
    "./events": {
      "types": "./dist/v0.1/zod/events.d.ts",
      "default": "./dist/v0.1/zod/events.js"
    },
    "./validators": {
      "types": "./dist/v0.1/zod/validators.d.ts",
      "default": "./dist/v0.1/zod/validators.js"
    },
    "./json-schema/*": "./v0.1/json-schema/*",
    "./v0.1/json-schema/*": "./v0.1/json-schema/*",
    "./v0.3": {
      "types": "./dist/v0.3/index.d.ts",
      "default": "./dist/v0.3/index.js"
    },
    "./v0.3/json-schema/*": "./v0.3/json-schema/*"
  },
  "scripts": {
    "build": "npm run generate && npm run compile",
    "generate": "node scripts/generate-from-json-schema.js",
    "compile": "tsc",
    "test": "vitest run && npm run test:node",
    "test:node": "node scripts/smoke-node-esm.mjs",
    "test:watch": "vitest",
    "validate": "node scripts/validate-examples.js",
    "typecheck:v0.3": "tsc -p tsconfig.v0.3.json"
  },
  "keywords": [
    "bookmanifest",
    "book-manifest",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "author": "Ray García <ray@bookmanifest.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bookmanifest/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/bookmanifest/schemas/issues"
  },
  "homepage": "https://bookmanifest.org",
  "files": [
    "dist/",
    "v0.1/json-schema/",
    "v0.1/typescript/",
    "v0.3/json-schema/",
    "docs/v0.3/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^13.0.0",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@bds/schemas",
  "version": "0.1.0",
  "description": "Formal schemas for BDS (Book Distribution Standard)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-schema": "./v0.1/json-schema/index.json",
    "./entities": {
      "types": "./dist/zod/entities.d.ts",
      "default": "./dist/zod/entities.js"
    },
    "./events": {
      "types": "./dist/zod/events.d.ts",
      "default": "./dist/zod/events.js"
    },
    "./validators": {
      "types": "./dist/zod/validators.d.ts",
      "default": "./dist/zod/validators.js"
    }
  },
  "scripts": {
    "build": "npm run generate && npm run compile",
    "generate": "node scripts/generate-from-json-schema.js",
    "compile": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-examples.js"
  },
  "keywords": [
    "bds",
    "book-distribution",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "author": "Ray García <ray@bookmanifest.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bookmanifest/bds-spec.git"
  },
  "bugs": {
    "url": "https://github.com/bookmanifest/bds-spec/issues"
  },
  "homepage": "https://bookmanifest.org",
  "files": [
    "dist/",
    "v0.1/json-schema/",
    "v0.1/typescript/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^13.0.0",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/entities/author.json",
  "title": "Author",
  "description": "The creator of books in Book Manifest",
  "type": "object",
  "required": ["id", "handle", "name", "created_at", "updated_at"],
  "properties": {
    "id": {
      "$ref": "../validators/did.json",
      "description": "Unique identifier for the author"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+\\.(bookmanifest\\.org|[a-zA-Z0-9-]+\\.[a-z]{2,})$",
      "description": "Human-readable handle (can use custom domain)",
      "examples": ["ray-garcia.bookmanifest.org", "author.example.com"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display name of the author"
    },
    "bio": {
      "type": "string",
      "maxLength": 5000,
      "description": "Author biography"
    },
    "avatar": {
      "$ref": "../validators/url.json",
      "description": "Profile image URL"
    },
    "links": {
      "type": "array",
      "description": "External links (website, social media)",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["website", "bluesky", "twitter", "mastodon", "instagram", "other"]
          },
          "url": {
            "$ref": "../validators/url.json"
          }
        }
      },
      "maxItems": 10
    },
    "created_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Last update timestamp"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/entities/reader.json",
  "title": "Reader",
  "description": "The user who reads books. Owns their reading data.",
  "type": "object",
  "required": ["id", "created_at", "updated_at"],
  "properties": {
    "id": {
      "$ref": "../validators/did.json",
      "description": "Unique identifier for the reader"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+\\.(bds\\.pub|[a-zA-Z0-9-]+\\.[a-z]{2,})$",
      "description": "Human-readable handle (optional for readers)",
      "examples": ["jorge.bookmanifest.org", "reader.example.com"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display name"
    },
    "avatar": {
      "$ref": "../validators/url.json",
      "description": "Profile image URL"
    },
    "created_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Last update timestamp"
    },
    "preferences": {
      "type": "object",
      "description": "Reading preferences",
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "sepia"],
          "description": "UI theme preference"
        },
        "font_size": {
          "type": "string",
          "enum": ["small", "medium", "large", "xlarge"],
          "description": "Font size preference"
        },
        "font_family": {
          "type": "string",
          "enum": ["serif", "sans-serif", "monospace"],
          "description": "Font family preference"
        },
        "line_height": {
          "type": "string",
          "enum": ["compact", "normal", "relaxed", "loose"],
          "description": "Line height preference"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/entities/chapter.json",
  "title": "Chapter",
  "description": "The content of a specific version of a chapter. Each version is a separate, immutable document.",
  "type": "object",
  "required": ["id", "chapter_id", "book_id", "version", "title", "slug", "created_at", "metadata", "content"],
  "properties": {
    "id": {
      "$ref": "../validators/did.json",
      "description": "Unique ID for this specific version (includes version in DID)"
    },
    "chapter_id": {
      "$ref": "../validators/did.json",
      "description": "Base chapter identifier (version-agnostic)"
    },
    "book_id": {
      "$ref": "../validators/did.json",
      "description": "Reference to parent Book"
    },
    "version": {
      "$ref": "../validators/semver.json",
      "description": "Chapter version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Chapter title"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200,
      "description": "URL-friendly identifier"
    },
    "created_at": {
      "$ref": "../validators/iso8601.json",
      "description": "Creation timestamp"
    },
    "metadata": {
      "type": "object",
      "required": ["word_count", "estimated_reading_time_minutes"],
      "properties": {
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Word count"
        },
        "estimated_reading_time_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated reading time"
        },
        "pov_character": {
          "type": "string",
          "maxLength": 200,
          "description": "Point of view character (for analytics)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "maxItems": 20,
          "description": "Content tags (for analytics)"
        }
      },
      "additionalProperties": false
    },
    "content": {
      "$ref": "./prosemirror.json",
      "description": "Chapter content in ProseMirror JSON format"
    }
  },
  "additionalProperties": false
}

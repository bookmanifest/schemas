{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/batch.json",
  "title": "Event Batch",
  "description": "A batch of 1 to 100 events: the five session events (heartbeat, chapter_transition, book_lifecycle, interaction, app_lifecycle) and the five reading events (reread, shared_entry, companion_open, recap_view, spoiler_warning).",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "$ref": "./heartbeat.json"
          },
          {
            "$ref": "./chapter-transition.json"
          },
          {
            "$ref": "./book-lifecycle.json"
          },
          {
            "$ref": "./interaction.json"
          },
          {
            "$ref": "./app-lifecycle.json"
          },
          {
            "$ref": "./reread.json"
          },
          {
            "$ref": "./shared-entry.json"
          },
          {
            "$ref": "./companion-open.json"
          },
          {
            "$ref": "./recap-view.json"
          },
          {
            "$ref": "./spoiler-warning.json"
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

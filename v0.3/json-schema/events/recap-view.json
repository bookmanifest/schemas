{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/recap-view.json",
  "title": "Recap View Event (v0.3)",
  "description": "The «what happened» recap (a few lines of the story up to where the reader stopped) was offered, viewed or dismissed. The gap since the last reading is sent as a coarse bucket.",
  "allOf": [
    {
      "$ref": "./envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "recap_view"
        },
        "payload": {
          "type": "object",
          "required": [
            "action",
            "trigger",
            "at_node_id",
            "dormancy"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "offered",
                "viewed",
                "dismissed"
              ]
            },
            "trigger": {
              "type": "string",
              "enum": [
                "return_prompt",
                "manual"
              ],
              "description": "`return_prompt`: offered on coming back after a pause. `manual`: opened from the menu."
            },
            "at_node_id": {
              "type": "string",
              "pattern": "^p-[0-9]{3,}$",
              "description": "Paragraph the recap runs up to (context chapter)."
            },
            "dormancy": {
              "type": "string",
              "enum": [
                "<1d",
                "1-3d",
                "4-7d",
                "8-30d",
                "31d+"
              ],
              "description": "Time since the previous reading on this device, bucketed."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

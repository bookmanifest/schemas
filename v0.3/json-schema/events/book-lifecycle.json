{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/book-lifecycle.json",
  "title": "Book Lifecycle Event",
  "description": "Major milestones in book reading (started, completed)",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "properties": {
        "type": { "const": "book_lifecycle" },
        "payload": {
          "type": "object",
          "required": ["action", "trigger", "total_active_reading_time_seconds", "completion_percentage", "chapters_started", "chapters_completed"],
          "properties": {
            "action": {
              "type": "string",
              "enum": ["started", "completed"],
              "description": "Lifecycle action"
            },
            "trigger": {
              "type": "string",
              "minLength": 1,
              "description": "What triggered this action"
            },
            "total_active_reading_time_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Total active reading time"
            },
            "completion_percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Book completion percentage"
            },
            "chapters_started": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of chapters started"
            },
            "chapters_completed": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of chapters completed"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/envelope.json",
  "title": "Event Envelope (DRAFT v0.3)",
  "description": "DRAFT. The v0.1 envelope, unchanged except that `type` also admits four v0.3 reading events (`shared_entry` has its own envelope without identity: envelope-anonymous.json). `reader_id` is the pseudonymous, random reader id of v0.1 (never derived from the device, deleted on opt-out); it is used only to count distinct readers for aggregation thresholds and is never shown to authors.",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "type",
    "session_id",
    "context",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier"
    },
    "timestamp": {
      "$ref": "../validators/iso8601.json",
      "description": "When the event occurred (client time)"
    },
    "type": {
      "type": "string",
      "enum": [
        "heartbeat",
        "chapter_transition",
        "book_lifecycle",
        "interaction",
        "app_lifecycle",
        "reread",
        "companion_open",
        "recap_view",
        "spoiler_warning"
      ],
      "description": "Event type"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Groups events from one reading session"
    },
    "context": {
      "type": "object",
      "required": [
        "reader_id",
        "book_id",
        "manifest_id",
        "manifest_version",
        "chapter_id",
        "chapter_version",
        "device_type",
        "app_id",
        "app_version"
      ],
      "properties": {
        "reader_id": {
          "$ref": "../validators/did.json"
        },
        "book_id": {
          "$ref": "../validators/did.json"
        },
        "manifest_id": {
          "$ref": "../validators/did.json"
        },
        "manifest_version": {
          "$ref": "../validators/semver.json"
        },
        "chapter_id": {
          "$ref": "../validators/did.json"
        },
        "chapter_version": {
          "$ref": "../validators/semver.json"
        },
        "device_type": {
          "type": "string",
          "enum": [
            "mobile",
            "tablet",
            "desktop"
          ]
        },
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "$ref": "../validators/semver.json"
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data"
    }
  },
  "additionalProperties": false
}

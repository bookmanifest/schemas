{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/heartbeat.json",
  "title": "Heartbeat Event",
  "description": "Periodic reading activity tracking",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "properties": {
        "type": { "const": "heartbeat" },
        "payload": {
          "type": "object",
          "required": ["duration_seconds", "active_seconds", "start_node_id", "end_node_id", "focus_node_id", "progress_percentage"],
          "properties": {
            "duration_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600,
              "description": "Time since last heartbeat"
            },
            "active_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600,
              "description": "Time with detected user interaction"
            },
            "start_node_id": {
              "type": "string",
              "minLength": 1,
              "description": "First visible paragraph"
            },
            "end_node_id": {
              "type": "string",
              "minLength": 1,
              "description": "Last visible paragraph"
            },
            "focus_node_id": {
              "type": "string",
              "minLength": 1,
              "description": "Center of viewport"
            },
            "progress_percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Position in chapter (0-1)"
            },
            "visible": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "description": "Optional. The paragraphs the screen or page showed, in reading order, each with the number of its words that were on it. A paginated reader knows these exactly; a consumer then shares the heartbeat's time by these words instead of estimating them from the range.",
              "items": {
                "type": "object",
                "required": ["node_id", "words"],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "pattern": "^p-[0-9]{3,}$",
                    "description": "Paragraph id"
                  },
                  "words": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000,
                    "description": "Words of the paragraph that were shown"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

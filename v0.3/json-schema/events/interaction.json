{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmanifest.org/schemas/v0.3/events/interaction.json",
  "title": "Interaction Event",
  "description": "User interactions with content (highlights, annotations, etc.)",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "properties": {
        "type": { "const": "interaction" },
        "payload": {
          "type": "object",
          "required": ["action", "target_node_id", "target_node_type", "selection_length"],
          "properties": {
            "action": {
              "type": "string",
              "enum": ["highlight", "comment", "copy", "share", "bookmark", "search_definition", "link_click"],
              "description": "Type of interaction"
            },
            "target_node_id": {
              "type": "string",
              "minLength": 1,
              "description": "ProseMirror node ID"
            },
            "target_node_type": {
              "type": "string",
              "minLength": 1,
              "description": "Type of node"
            },
            "text_selection": {
              "type": "string",
              "description": "Selected text (if applicable)"
            },
            "selection_length": {
              "type": "integer",
              "minimum": 0,
              "description": "Length of selected text"
            },
            "annotation": {
              "type": "string",
              "description": "User annotation (if applicable)"
            },
            "fragment": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Offset of the first character of the fragment in the paragraph's plain text, in UTF-16 code units"
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Offset just after the last character of the fragment, in UTF-16 code units; greater than start"
                }
              },
              "additionalProperties": false,
              "description": "Optional. The part of the target paragraph the reader acted on, as positions in the paragraph's plain text; absent means the whole paragraph. Positions only, never text. When present, selection_length SHOULD be end minus start, and end MUST be greater than start (a consumer discards a fragment that is not)."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
